---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

const home = (await getCollection('pages')).find((p) => p.id === 'index');
if (!home) throw new Error('index.md missing from src/content/pages');
const { Content } = await render(home);
const { title, description, cta } = home.data;
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-3xl px-5 pb-20 pt-16 sm:pt-24">
    <h1
      class="mb-10 text-balance text-center font-display text-3xl font-bold leading-tight text-[var(--color-brand-dark)] sm:text-4xl md:text-5xl"
    >
      {title}
    </h1>

    <div class="prose">
      <Content />
    </div>

    {cta && <Cta label={cta.label} href={cta.href} note={cta.note} size="large" />}
  </section>
</Base>
