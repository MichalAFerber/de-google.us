---
interface Props {
  label: string;
  href: string;
  note?: string;
  size?: 'default' | 'large';
}
const { label, href, note, size = 'default' } = Astro.props;
const big = size === 'large';

// Match trailingSlash: 'always' so internal CTAs don't take a redirect hop.
const isInternal = href.startsWith('/') && !href.includes('#') && !/\.[a-z0-9]+$/i.test(href);
const url = isInternal && !href.endsWith('/') ? `${href}/` : href;
---

<div class:list={['cta', { 'cta-center': big }]}>
  <a
    href={url}
    class:list={[
      'inline-flex items-center gap-2 rounded-lg bg-[var(--color-btn)] font-semibold text-white no-underline transition-colors hover:bg-[var(--color-btn-hover)]',
      big ? 'px-7 py-3.5 text-lg' : 'px-5 py-2.5 text-base',
    ]}
  >
    {label}
    <span aria-hidden="true">→</span>
  </a>
  {note && <p class="mt-3 text-sm italic text-[var(--color-ink-muted)]">{note}</p>}
</div>

<style>
  .cta {
    margin-top: 2.5rem;
  }
  .cta-center {
    text-align: center;
  }
</style>
