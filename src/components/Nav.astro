---
import { getCollection } from 'astro:content';

// Guides dropdown = the tier-1 / tier-2 pages, in reading order.
const guides = (await getCollection('pages'))
  .filter((p) => p.data.tier === 'tier-1' || p.data.tier === 'tier-2')
  .sort((a, b) => a.data.order - b.data.order);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href);
---

<nav class="border-b border-[var(--color-rule)] bg-[var(--color-paper)]/90 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-3">
    <a href="/" class="font-display text-base font-bold tracking-wide text-[var(--color-brand-dark)] no-underline sm:text-lg">
      de-google<span class="text-[var(--color-ink-muted)]">.us</span>
    </a>

    <div class="flex flex-wrap items-center justify-end gap-1 text-sm sm:gap-2">
      <a href="/" class:list={["nav-link", { active: isActive('/') }]}>Home</a>
      <a href="/illusion-of-choice/" class:list={["nav-link", { active: isActive('/illusion-of-choice') }]}>Why</a>
      <a href="/start-here/" class:list={["nav-link", { active: isActive('/start-here') }]}>Start&nbsp;Here</a>

      <details class="guides relative">
        <summary class="nav-link cursor-pointer list-none select-none">Guides</summary>
        <ul class="absolute right-0 mt-2 w-64 rounded-md border border-[var(--color-rule)] bg-[var(--color-paper)] p-1 shadow-lg">
          {guides.map((g) => (
            <li>
              <a href={`/${g.id}/`} class="block rounded px-3 py-2 text-[var(--color-ink)] no-underline hover:bg-[var(--color-rule)]/50">
                {g.data.title}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <div class="flex items-center gap-1 sm:gap-2">
      <a
        href="https://github.com/MichalAFerber/de-google.us"
        target="_blank"
        rel="noopener"
        class="nav-link icon-link"
        aria-label="Source code on GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>

      <button id="theme-toggle" type="button" class="nav-link theme-toggle" aria-label="Toggle dark mode" aria-pressed="false">
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      </div>
    </div>
  </div>
</nav>

<style>
  nav {
    /* sticky chrome respects notches (viewport-fit=cover) */
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem; /* ≥40px tap target */
    border-radius: 0.375rem;
    padding: 0.35rem 0.6rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .theme-toggle,
  .icon-link {
    min-width: 2.5rem;
    justify-content: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .theme-toggle svg,
  .icon-link svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .nav-link:hover {
    color: var(--color-brand);
  }
  .nav-link.active {
    color: var(--color-brand-dark);
  }
  /* No-JS accessible dropdown via <details> */
  .guides summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close the Guides dropdown on outside-click / Escape.
  document.querySelectorAll<HTMLDetailsElement>('details.guides').forEach((d) => {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') d.open = false;
    });
  });

  // Theme toggle: overrides the system default, persists the choice.
  // (A pre-paint script in Base.astro applies the stored choice before render.)
  const toggle = document.getElementById('theme-toggle');
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  const currentTheme = () => document.documentElement.dataset.theme ?? (mq.matches ? 'dark' : 'light');
  const reflect = () => toggle?.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode — theme just won't persist */
    }
    reflect();
  });
  mq.addEventListener('change', reflect);
  reflect();
</script>
