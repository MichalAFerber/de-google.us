---
import Search from './Search.astro';
---

<footer class="mt-auto border-t border-[var(--color-rule)] bg-[var(--color-paper)]">
  <div class="mx-auto max-w-3xl px-5 py-10">
    <div class="mb-8">
      <p class="mb-2 text-sm font-medium text-[var(--color-ink-muted)]">Search the site</p>
      <Search />
    </div>

    <div class="flex flex-col gap-3 border-t border-[var(--color-rule)] pt-6 text-sm text-[var(--color-ink-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <a href="/what-i-couldnt-leave/" class="text-[var(--color-ink)] underline underline-offset-2 hover:text-[var(--color-brand)]">
          What I couldn’t leave
        </a>
        <span class="rounded bg-brand/10 px-1.5 py-0.5 font-mono text-xs text-[var(--color-ink)]">
          the honest version, from someone who does this for a living
        </span>
      </p>
      <nav class="flex items-center gap-2" aria-label="Legal and source">
        <a href="/privacy/" class="underline underline-offset-2 hover:text-[var(--color-brand)]">Privacy</a>
        <span class="opacity-40">·</span>
        <a href="/terms/" class="underline underline-offset-2 hover:text-[var(--color-brand)]">Terms</a>
        <span class="opacity-40">·</span>
        <a
          href="https://github.com/MichalAFerber/de-google.us"
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-10 min-w-10 items-center justify-center rounded hover:text-[var(--color-brand)]"
          aria-label="Source code on GitHub"
        >
          <svg class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
      </nav>
    </div>

    <p class="mt-6 text-center text-sm text-[var(--color-ink-muted)]">
      &copy; 2026 | Created with <i class="icon-heart" title="Love"></i> by
      <a href="https://michalferber.me" target="_blank" rel="noopener" class="text-[var(--color-ink)] underline underline-offset-2 hover:text-[var(--color-brand)]">Michal Ferber, aka TechGuyWithABeard</a>
    </p>
  </div>
</footer>

<style>
  /* No icon font on this site (self-hosted, de-Googled) — render the heart inline. */
  .icon-heart {
    font-style: normal;
  }
  .icon-heart::before {
    content: "\2665";
    color: var(--color-brand);
  }
</style>
