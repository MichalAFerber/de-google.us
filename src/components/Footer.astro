---
import Search from './Search.astro';
---

<footer class="mt-auto border-t border-[var(--color-rule)] bg-[var(--color-paper)]">
  <div class="mx-auto max-w-3xl px-5 py-10">
    <div class="mb-8">
      <p class="mb-2 text-sm font-medium text-[var(--color-ink-muted)]">Search the site</p>
      <Search />
    </div>

    <div class="flex flex-col gap-3 border-t border-[var(--color-rule)] pt-6 text-sm text-[var(--color-ink-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>
        <a href="/what-i-couldnt-leave/" class="text-[var(--color-ink)] underline underline-offset-2 hover:text-[var(--color-brand)]">
          What I couldn’t leave
        </a>
        <span class="mx-2 opacity-40">·</span>
        the honest version, from someone who does this for a living
      </p>
      <nav class="flex items-center gap-2" aria-label="Legal">
        <a href="/privacy/" class="underline underline-offset-2 hover:text-[var(--color-brand)]">Privacy</a>
        <span class="opacity-40">·</span>
        <a href="/terms/" class="underline underline-offset-2 hover:text-[var(--color-brand)]">Terms</a>
      </nav>
    </div>

    <p class="mt-6 border-t border-[var(--color-rule)] pt-6 text-sm text-[var(--color-ink-muted)]">
      &copy; 2026 | Created with <i class="icon-heart" title="Love"></i> by
      <a href="https://michalferber.me" target="_blank" rel="noopener" class="text-[var(--color-ink)] underline underline-offset-2 hover:text-[var(--color-brand)]">Michal Ferber, aka TechGuyWithABeard</a>
    </p>
  </div>
</footer>

<style>
  /* No icon font on this site (self-hosted, de-Googled) — render the heart inline. */
  .icon-heart {
    font-style: normal;
  }
  .icon-heart::before {
    content: "\2665";
    color: var(--color-brand);
  }
</style>
